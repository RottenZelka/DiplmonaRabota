# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8888/api

# Google Maps API Key
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Feature Flags
REACT_APP_ENABLE_FILE_UPLOAD=true
REACT_APP_ENABLE_GOOGLE_MAPS=true

# Pagination
REACT_APP_DEFAULT_PAGE_SIZE=10

# Cookie Configuration
REACT_APP_COOKIE_DOMAIN=localhost
REACT_APP_COOKIE_SECURE=false
REACT_APP_COOKIE_SAME_SITE=lax