# Application Environment
YII_DEBUG=true
YII_ENV=dev

# API Configuration
API_BASE_URL=http://localhost:8888/api
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=yii2db
DB_USER=yii2user
DB_PASSWORD=yii2password
DB_CHARSET=utf8

# JWT Configuration
JWT_SECRET=dsauvbfbcuoiweryfodycabgsodyifbuywervbsdfoucybrpwufbewr
JWT_REFRESH_SECRET=sciaudgbfoicywrsbdifpcbnewpruifhoicywrsdfioyvbcowiyf
JWT_EXPIRATION=86400  # 24 hours in seconds

# File Upload Configuration
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
UPLOAD_DIR=uploads

# MinIO Configuration (for file storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_USE_SSL=false

# Pagination
DEFAULT_PAGE_SIZE=21

# Feature Flags
ENABLE_FILE_UPLOAD=true
ENABLE_GOOGLE_MAPS=true

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="School Management System"

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8888

# Cookie Configuration
COOKIE_VALIDATION_KEY=your_cookie_validation_key_here
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=None

# Redis Configuration (if needed)
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here